# 이 파일을 참고해 .env.local을 만듭니다. 기존 .env.local은 덮어쓰지 않습니다.
# 배포 앱에 포함되는 공개 수집 설정입니다. 개인 API 토큰이나 관리용 인증 키는 넣지 않습니다.
BOOKMANAGER_SENTRY_DSN=
BOOKMANAGER_POSTHOG_TOKEN=
# 프로젝트의 데이터 지역과 일치하는 수집 주소를 사용합니다. EU: https://eu.i.posthog.com
BOOKMANAGER_POSTHOG_HOST=https://us.i.posthog.com
# 개발 실행에서는 기본적으로 전송하지 않습니다.
# 테스트가 필요하면 실행 명령의 환경 변수로 1을 지정하고 앱의 해당 사용 설정이 켜져 있는지 확인합니다.
# 이 값은 .env.local에서 읽어 배포 앱에 포함하지 않습니다.
BOOKMANAGER_TELEMETRY_DEV=0
