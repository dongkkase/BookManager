{
  "name": "bookmanager",
  "version": "3.0.0",
  "type": "module",
  "description": "BookManager - ComicZIP Optimizer migrated to Electron + React",
  "main": "electron/bootstrap.js",
  "author": "dongkkase",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "node:rebuild": "npm rebuild better-sqlite3",
    "test": "node electron/runNodeTests.cjs",
    "build": "vite build",
    "postbuild": "node electron/runElectronBuilder.cjs --prepare-default-win-code-sign-cache",
    "preview": "vite preview",
    "electron:rebuild": "electron-builder install-app-deps",
    "electron:dev": "node electron/runElectronDev.cjs --dist-watch",
    "electron:dev:rebuild": "npm run electron:rebuild && npm run electron:dev",
    "electron:dev:unsafe": "node electron/runElectronDev.cjs --dist-watch --unsafe-dev-node",
    "electron:dev:unsafe:rebuild": "npm run electron:rebuild && npm run electron:dev:unsafe",
    "electron:dev:fast": "concurrently \"vite build --watch\" \"wait-on dist/index.html && node electron/launchElectronWatch.cjs\"",
    "electron:preview": "vite build && node electron/launchElectronProd.cjs",
    "electron:build": "vite build && node electron/runElectronBuilder.cjs",
    "electron:build:win": "vite build && node electron/runElectronBuilder.cjs --win",
    "electron:build:mac": "vite build && node electron/runElectronBuilder.cjs --mac",
    "electron:build:linux": "vite build && node electron/runElectronBuilder.cjs --linux"
  },
  "devDependencies": {
    "@electron/notarize": "^2.2.1",
    "@vitejs/plugin-react": "^4.2.1",
    "7zip-bin": "^5.2.0",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.1.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@vuvandinh203/react-flipbook": "^1.0.2",
    "better-sqlite3": "^9.4.3",
    "express": "^4.18.2",
    "node-7z": "^3.0.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tts-react": "^3.0.7",
    "webdav": "^5.3.0"
  },
  "build": {
    "appId": "com.bookmanager.app",
    "productName": "BookManager",
    "executableName": "BookManager",
    "afterSign": "electron/notarize.cjs",
    "afterPack": "electron/afterPack.cjs",
    "afterAllArtifactBuild": "electron/zipWindowsPortable.cjs",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      {
        "from": "src/utils",
        "to": "src/utils",
        "filter": [
          "i18n.js",
          "i18nData.js",
          "folderUtils.js"
        ]
      },
      {
        "from": "src/metadata",
        "to": "src/metadata",
        "filter": [
          "metadataTypes.js"
        ]
      },
      "version.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": ["**/*"]
      },
      {
        "from": "src",
        "to": "src",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": true,
      "artifactName": "BookManager.exe",
      "icon": "src/images/app.ico"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": ["universal"]
        }
      ],
      "artifactName": "BookManager-mac.${ext}",
      "icon": "src/images/app-1024.png",
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "icon": "src/images/app.png",
      "category": "Utility"
    }
  }
}
